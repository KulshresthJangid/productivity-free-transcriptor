# Copy to .env and fill in. .env is git-ignored.
MONGO_USER=admin
MONGO_PASSWORD=change-me-to-a-long-password
# 32+ random characters, e.g. generate with:  openssl rand -hex 32
JWT_SECRET=change-me-to-64-random-hex-characters-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# large-v3 = most accurate. medium/small are much faster on CPU.
WHISPER_MODEL=large-v3
WHISPER_DEVICE=auto
