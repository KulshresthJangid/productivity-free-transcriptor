# Copy to .env and fill in. .env is git-ignored.
# Shared MongoDB already running on the host (published on 27017). Use a dedicated user, not root.
# host.docker.internal = the host, as seen from the app container.
MONGO_URI=mongodb://transcriptor:CHANGE_ME@host.docker.internal:27017/transcriptor?authSource=transcriptor
# RabbitMQ job queue (run scripts/setup-rabbitmq.sh to create the user and fill this in)
RABBIT_URL=amqp://transcriptor:CHANGE_ME@host.docker.internal:5672/transcriptor
# 32+ random characters, e.g. generate with:  openssl rand -hex 32
JWT_SECRET=change-me-to-64-random-hex-characters-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# large-v3 = most accurate. medium/small are much faster on CPU.
WHISPER_MODEL=large-v3
WHISPER_DEVICE=auto

# Folder on the big (1 TB) disk. Models, database and temp files all live here, not on the SSD.
# ./deploy.sh checks that it is a different disk from / and creates the sub-folders.
DATA_DIR=/mnt/data1tb

# Worker limits: CPU cores it may use, and its memory cap. Keep CPUs below the host's total.
WORKER_CPUS=4
WORKER_MEM=6g
